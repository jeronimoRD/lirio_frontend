{
  "expo": {
    "name": "Hibirio",
    "slug": "lirio-hibisco",
    "scheme": "hibirio",
    "version": "1.0.0",
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#A81245",
          "defaultChannel": "default"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCFAF8"
      },
      "package": "com.hibirio.app",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc1dc5a7-0a14-4ee0-97a6-b7a19d28b0c6"
      }
    },
    "owner": "korezz"
  }
}
